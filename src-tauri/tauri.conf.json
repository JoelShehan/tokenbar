{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenBar",
  "version": "0.1.0",
  "identifier": "com.tokenbar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TokenBar",
        "visible": false,
        "width": 320,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Yowel Shehan Alahakoon",
    "category": "DeveloperTool",
    "shortDescription": "AI usage at a glance",
    "longDescription": "A local desktop widget for Codex subscription quotas and OpenAI organization API usage.",
    "copyright": "Copyright © 2026 Yowel Shehan Alahakoon",
    "homepage": "https://github.com/JoelShehan/tokenbar",
    "windows": {
      "allowDowngrades": false,
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    },
    "macOS": { "minimumSystemVersion": "12.0", "hardenedRuntime": true },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
